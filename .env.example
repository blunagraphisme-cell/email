# EmailOqui — environment variables
# Copy this file to .env and adjust values as needed.

# SQLite database URL (local file)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ============================================================
# Google OAuth 2.0 (for "Continue with Google" sign-in)
# ============================================================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/google/callback   (dev)
#   - https://email.oquitogo.online/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public app URL (used to build OAuth redirect URIs)
APP_URL="http://localhost:3000"

# ============================================================
# Resend (email sending provider — server-side only)
# ============================================================
# Get your API key at https://resend.com/api-keys
# Leave empty to use the simulated send (dev mode — no real emails sent)
RESEND_API_KEY=""

# From email used when RESEND_API_KEY is set. Must be on a verified domain.
RESEND_FROM_EMAIL="newsletter@email.oquitogo.online"

# Webhook secret used to verify incoming Resend event signatures
# (see https://resend.com/docs/dashboard/webhooks)
RESEND_WEBHOOK_SECRET=""

# ============================================================
# Payments (V1 simulation)
# ============================================================
PAYMENT_SECRET=""

# Session cookie signing secret (rotate per environment)
SESSION_SECRET=""

# ============================================================
# App metadata
# ============================================================
NEXT_PUBLIC_APP_NAME="EmailOqui"
NEXT_PUBLIC_APP_DOMAIN="email.oquitogo.online"
