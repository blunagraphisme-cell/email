# EmailOqui — Configuration production (TEMPLATE)
# Copiez ce fichier vers .env sur le VPS et remplacez les valeurs

# Port de l'application (CHANGEZ si 3000 est déjà utilisé par une autre app)
PORT=3001

# Base de données (SQLite — fichier local)
DATABASE_URL="file:/opt/emailoqui/db/custom.db"

# ============================================================
# Google OAuth 2.0
# Récupérez vos identifiants sur https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée: https://email.oquitogo.online/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID="VOTRE_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="VOTRE_GOOGLE_CLIENT_SECRET"

# URL publique de l'app
APP_URL="https://email.oquitogo.online"

# ============================================================
# Resend (envoi d'e-mails)
# Récupérez votre clé API sur https://resend.com/api-keys
# Vérifiez le domaine email.oquitogo.online dans Resend
# ============================================================
RESEND_API_KEY="VOTRE_RESEND_API_KEY"
RESEND_FROM_EMAIL="newsletter@email.oquitogo.online"
RESEND_WEBHOOK_SECRET=""

# ============================================================
# Sécurité (générez avec: openssl rand -hex 32)
# ============================================================
SESSION_SECRET=""
PAYMENT_SECRET=""

# ============================================================
# App metadata
# ============================================================
NEXT_PUBLIC_APP_NAME="EmailOqui"
NEXT_PUBLIC_APP_DOMAIN="email.oquitogo.online"
