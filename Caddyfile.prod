# EmailOqui — Snippet Caddy à AJOUTER à votre Caddyfile existant
# (ne remplacez PAS votre Caddyfile complet si d'autres apps tournent déjà)
#
# Installation:
#   sudo nano /etc/caddy/Caddyfile
#   → collez le bloc ci-dessous à la fin du fichier
#   → changez le port 3001 si vous utilisez un autre port dans .env
#   sudo systemctl reload caddy

email.oquitogo.online {
	# IMPORTANT: changez le port si vous avez mis un autre PORT dans .env
	reverse_proxy localhost:3001 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Sécurité
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Compression
	encode gzip

	# Cache des assets statiques Next.js
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache des favicons
	@favicon path /favicon.ico /favicon-16x16.png /apple-touch-icon.png /android-chrome-*.png /logo.png
	header @favicon Cache-Control "public, max-age=86400"

	# Logs
	log {
		output file /var/log/caddy/emailoqui.log
		format json
	}
}
