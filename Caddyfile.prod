# EmailOqui — Caddy production config
# Reverse proxy + SSL automatique (Let's Encrypt)
#
# Installation:
#   sudo cp /opt/emailoqui/Caddyfile.prod /etc/caddy/Caddyfile
#   sudo systemctl restart caddy

email.oquitogo.online {
	# Reverse proxy vers le serveur Next.js (port 3000)
	reverse_proxy localhost:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Sécurité
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Compression
	encode gzip

	# Cache des assets statiques Next.js
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache des favicons
	@favicon path /favicon.ico /favicon-16x16.png /apple-touch-icon.png /android-chrome-*.png /logo.png
	header @favicon Cache-Control "public, max-age=86400"

	# Logs
	log {
		output file /var/log/caddy/emailoqui.log
		format json
	}
}
